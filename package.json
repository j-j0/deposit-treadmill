{
  "name": "deposit-treadmill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Are you gaining or losing ground on an Australian house deposit?",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-data": "vitest run tests/data.test.ts",
    "refresh-data": "node scripts/refresh-data.mjs",
    "refresh-data:dry": "node scripts/refresh-data.mjs --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "~5.9.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
